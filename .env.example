# ============================================
# ACES System — Environment Template
# Copy this to .env and fill in your values.
# ============================================

# ---------- Application ----------
APP_NAME="ACES Activity Tracking System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/cair-system
APP_TIMEZONE=Asia/Manila

# ---------- Database ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aces_db
DB_USER=root
DB_PASS=

# ---------- Email / SMTP ----------
# For Gmail: enable 2FA and generate an App Password
# https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="ACES Unit - KLD"

# ---------- Security ----------
# Generate with: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 64 | ForEach-Object {[char]$_})
CSRF_SECRET=generate_a_random_64_char_string
SESSION_LIFETIME=3600
PASSWORD_COST=12

# ---------- Uploads ----------
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=pdf,doc,docx,ppt,pptx,mp4

# ---------- Cron ----------
CRON_SECRET=generate_another_random_string
