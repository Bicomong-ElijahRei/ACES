# ============================================
# ACES System - Git Ignore Rules
# ============================================

# Environment files (contain secrets)
.env
.env.local
.env.*.local

# Config files with credentials
config/email.php
config/database.php

# Logs
*.log
logs/
!logs/.gitkeep

# Uploaded files (user data - do not commit)
uploads/*
!uploads/.htaccess
!uploads/modules/
!uploads/modules/.htaccess

# Backups
backups/
*.sql
*.sql.gz
*.zip

# Dependencies
/vendor/
node_modules/

# IDE / Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.bak
*.orig
# Legacy files (deleted)
student.php
att_verification.php
api/toggle_task.php
